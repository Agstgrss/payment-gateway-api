{
  "info": {
    "name": "Payment Gateway API - Fluxo de Testes",
    "description": "Coleção orientada pelos passos do guia de testes (login, CRUD de produtos, fluxo de compra/publicação e rotas privadas).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{TOKEN}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "BASE_URL",
      "value": "http://localhost:8000/api"
    },
    {
      "key": "TOKEN",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Autenticação",
      "item": [
        {
          "name": "Login Admin",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const data = pm.response.json();",
                  "if (data.token) {",
                  "    pm.collectionVariables.set('TOKEN', data.token);",
                  "    pm.environment.set('TOKEN', data.token);",
                  "    pm.globals.set('TOKEN', data.token);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"email\": \"admin@example.com\", \"password\": \"admin123\"}"
            },
            "url": {
              "raw": "{{BASE_URL}}/login",
              "host": [
                "{{BASE_URL}}"
              ],
              "path": [
                "login"
              ]
            }
          }
        },
        {
          "name": "Login Usuário Comum",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"email\": \"test@example.com\", \"password\": \"password\"}"
            },
            "url": {
              "raw": "{{BASE_URL}}/login",
              "host": [
                "{{BASE_URL}}"
              ],
              "path": [
                "login"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Produtos",
      "item": [
        {
          "name": "Listar Produtos",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{BASE_URL}}/products",
              "host": [
                "{{BASE_URL}}"
              ],
              "path": [
                "products"
              ]
            }
          }
        },
        {
          "name": "Criar Produto",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"name\": \"Notebook Gamer\", \"amount\": 500000}"
            },
            "url": {
              "raw": "{{BASE_URL}}/products",
              "host": [
                "{{BASE_URL}}"
              ],
              "path": [
                "products"
              ]
            }
          },
          "description": "Cartão de crédito com transação de R$5.000,00 (500.000 centavos)."
        },
        {
          "name": "Detalhe Produto",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{BASE_URL}}/products/1",
              "host": [
                "{{BASE_URL}}"
              ],
              "path": [
                "products",
                "1"
              ]
            }
          }
        },
        {
          "name": "Atualizar Produto",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"amount\": 550000}"
            },
            "url": {
              "raw": "{{BASE_URL}}/products/1",
              "host": [
                "{{BASE_URL}}"
              ],
              "path": [
                "products",
                "1"
              ]
            }
          }
        },
        {
          "name": "Deletar Produto",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{BASE_URL}}/products/1",
              "host": [
                "{{BASE_URL}}"
              ],
              "path": [
                "products",
                "1"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Fluxo de Compras",
      "item": [
        {
          "name": "Realizar Compra (sucesso)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"product_id\": 1, \"quantity\": 1, \"name\": \"Augusto\", \"email\": \"augusto@email.com\", \"card_number\": \"5569000000006063\", \"cvv\": \"010\"}"
            },
            "url": {
              "raw": "{{BASE_URL}}/purchase",
              "host": [
                "{{BASE_URL}}"
              ],
              "path": [
                "purchase"
              ]
            }
          }
        },
        {
          "name": "Compra com fallback (CVV 200)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"product_id\": 1, \"quantity\": 1, \"name\": \"Tester\", \"email\": \"tester@email.com\", \"card_number\": \"5569000000006063\", \"cvv\": \"200\"}"
            },
            "url": {
              "raw": "{{BASE_URL}}/purchase",
              "host": [
                "{{BASE_URL}}"
              ],
              "path": [
                "purchase"
              ]
            }
          },
          "description": "CVV 200 aciona erro no Gateway 1 e garante que o Gateway 2 seja acionado."
        },
        {
          "name": "Compra - validação inválida",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"product_id\": 1, \"quantity\": 1, \"name\": \"Cliente\", \"email\": \"cliente@example.com\", \"card_number\": \"123\", \"cvv\": \"010\"}"
            },
            "url": {
              "raw": "{{BASE_URL}}/purchase",
              "host": [
                "{{BASE_URL}}"
              ],
              "path": [
                "purchase"
              ]
            }
          },
          "description": "Número do cartão com menos de 16 dígitos deve retornar 422."
        }
      ]
    },
    {
      "name": "Transações",
      "item": [
        {
          "name": "Listar Transações",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{BASE_URL}}/transactions",
              "host": [
                "{{BASE_URL}}"
              ],
              "path": [
                "transactions"
              ]
            }
          }
        },
        {
          "name": "Detalhe de Transação",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{BASE_URL}}/transactions/1",
              "host": [
                "{{BASE_URL}}"
              ],
              "path": [
                "transactions",
                "1"
              ]
            }
          }
        },
        {
          "name": "Reembolsar Transação",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{BASE_URL}}/transactions/1/refund",
              "host": [
                "{{BASE_URL}}"
              ],
              "path": [
                "transactions",
                "1",
                "refund"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Clientes",
      "item": [
        {
          "name": "Listar Clientes",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{BASE_URL}}/clients",
              "host": [
                "{{BASE_URL}}"
              ],
              "path": [
                "clients"
              ]
            }
          }
        },
        {
          "name": "Detalhar Cliente",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{BASE_URL}}/clients/1",
              "host": [
                "{{BASE_URL}}"
              ],
              "path": [
                "clients",
                "1"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Gateways",
      "item": [
        {
          "name": "Ativar/Desativar Gateway",
          "request": {
            "method": "PATCH",
            "header": [],
            "url": {
              "raw": "{{BASE_URL}}/gateways/1/toggle",
              "host": [
                "{{BASE_URL}}"
              ],
              "path": [
                "gateways",
                "1",
                "toggle"
              ]
            }
          }
        },
        {
          "name": "Alterar Prioridade",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"priority\": 1}"
            },
            "url": {
              "raw": "{{BASE_URL}}/gateways/1/priority",
              "host": [
                "{{BASE_URL}}"
              ],
              "path": [
                "gateways",
                "1",
                "priority"
              ]
            }
          }
        }
      ]
    }
  ]
}
